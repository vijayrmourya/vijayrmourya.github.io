{% extends "base.html.j2" %}

{% block content %}
      <section class="card hero-card">
        <h1>{{ services.hero.title }}</h1>
        <p class="subtitle">{{ services.hero.subtitle }}</p>
        <p class="small">
          {{ services.hero.intro }}
        </p>
      </section>

      <section class="section">
        <h2>Core Services</h2>
        <div class="grid" style="grid-template-columns: 1fr;">
{%- for service in services.core_services %}
          <div class="card" style="padding:24px">
            <div style="display:flex; align-items:start; gap:16px;">
              <span style="font-size:2.5rem; flex-shrink:0;">{{ service.icon }}</span>
              <div>
                <h3 style="margin:0 0 12px 0;">{{ service.title }}</h3>
                <p class="small" style="margin-bottom:12px;">
                  {{ service.description }}
                </p>
                <ul class="small" style="margin:0; padding-left:20px; line-height:1.8;">
{%- for bullet in service.bullets %}
                  <li>{{ bullet }}</li>
{%- endfor %}
                </ul>
              </div>
            </div>
          </div>
{%- endfor %}
        </div>
      </section>

      <section class="section" style="margin-top:32px;">
        <h2>How I Work</h2>
        <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap:16px;">
{%- for step in services.how_i_work %}
          <div class="card" style="padding:20px;">
            <h3 style="margin:0 0 10px 0; font-size:1.1rem;">{{ step.title }}</h3>
            <p class="small">
              {{ step.description }}
            </p>
          </div>
{%- endfor %}
        </div>
      </section>

      <section class="section" style="margin-top:32px;">
        <h2>Engagement Models</h2>
        <div class="grid" style="gap:16px;">
{%- for model in services.engagement_models %}
          <div class="card" style="padding:24px; background: linear-gradient(135deg, rgba(96,165,250,0.08), rgba(79,209,197,0.05));">
            <h3 style="margin:0 0 12px 0;">{{ model.title }}</h3>
            <p class="small">
              {{ model.description }}
            </p>
            <p class="small" style="margin-top:12px;">
              <strong>Best for:</strong> {{ model.best_for }}
            </p>
          </div>
{%- endfor %}
        </div>
      </section>

      <section class="section" style="margin-top:32px;">
        <div class="card" style="padding:32px; text-align:center; background: linear-gradient(135deg, rgba(96,165,250,0.1), rgba(79,209,197,0.05)); border: 1px solid rgba(96,165,250,0.2);">
          <h2 style="margin:0 0 16px 0;">{{ services.cta.title }}</h2>
          <p class="small" style="margin-bottom:24px; max-width:600px; margin-left:auto; margin-right:auto;">
            {{ services.cta.text }}
          </p>
          <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
{%- for button in services.cta.buttons %}
            <a href="{{ button.href }}" class="{{ button.style }}">{{ button.label }}</a>
{%- endfor %}
          </div>
        </div>
      </section>
{% endblock %}
